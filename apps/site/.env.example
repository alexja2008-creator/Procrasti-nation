# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# Web Push (reminders in browsers). Generate a pair with:
#   node -e 'console.log(require("web-push").generateVAPIDKeys())'
# The public key also goes in the Expo app as EXPO_PUBLIC_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://procrasti-nation.work

# Where the app lives (the landing page links there; v1's old paths redirect there).
# Optional: defaults to https://app.procrasti-nation.work. Locally: http://localhost:8081
# NEXT_PUBLIC_APP_URL=http://localhost:8081
