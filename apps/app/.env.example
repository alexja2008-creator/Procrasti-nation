# Copy to .env.local (gitignored). PUBLIC VALUES ONLY: everything here is
# bundled into the app and can be read by anyone who downloads it. Secret
# keys stay in apps/site and are reached through its /api/* routes.

# Supabase project (staging while v2 is in development).
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# Sign-in options to show, comma-separated: email, phone, apple, google.
# Turn phone/apple/google on only after the provider is set up in Supabase Auth
# (phone: Twilio Verify on a paid Twilio account; see PN2-HANDOFF.md, open items).
EXPO_PUBLIC_AUTH_PROVIDERS=email

# apps/site, for AI and other server work.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Web Push: apps/site's VAPID_PUBLIC_KEY (public by design; the private half stays in the site).
EXPO_PUBLIC_VAPID_PUBLIC_KEY=
